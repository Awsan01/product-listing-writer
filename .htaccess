# Product listing writer: rules for LiteSpeed and Apache.
# Each protection has a fallback, so the site stays locked down when a module is missing.

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8

# 1) mod_rewrite (LiteSpeed and most Apache hosts)
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Dotfiles and dot-folders such as .git, .env and .htaccess (.well-known stays open for SSL checks)
  RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]
  # Docs, config files, server-only code, tests and private storage
  RewriteRule \.md$ - [F,L,NC]
  RewriteRule (^|/)config[^/]*\.php$ - [F,L,NC]
  RewriteRule ^(api/lib|tests|listing-storage|private)(/|$) - [F,L,NC]
</IfModule>

# 2) mod_alias fallback for the same paths when mod_rewrite is missing
<IfModule !mod_rewrite.c>
  <IfModule mod_alias.c>
    RedirectMatch 403 /\.(?!well-known(/|$))
    RedirectMatch 403 (?i)\.md$
    RedirectMatch 403 (?i)/config[^/]*\.php$
    RedirectMatch 403 (?i)/(api/lib|tests|listing-storage|private)(/|$)
  </IfModule>
</IfModule>

# 3) File-name rules that work without either module
<FilesMatch "(?i)^(\..*|.*\.md|config.*\.php|.*\.(sh|mjs|csv|log|ini))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Security and caching headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpe?g|webp|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>
